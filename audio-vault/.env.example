# PostgreSQL connection string (Render, Neon, Supabase or your own server)
DATABASE_URL=postgres://user:password@localhost:5432/audio_vault
# Force TLS on/off for the database (default: on for remote hosts, off for localhost)
# DATABASE_SSL=true

# Long random string; keeps people logged in across restarts
SESSION_SECRET=change-me-to-a-long-random-string

# Where the audio files are stored (use a persistent disk in production)
STORAGE_DIR=./storage

# Public https address; used in invite links and M3U playlists
PUBLIC_URL=https://audio.example.com

MAX_UPLOAD_MB=500
PORT=3000
