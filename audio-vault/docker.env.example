# Copy to .env (same folder as docker-compose.yml) and fill in.
DB_PASSWORD=kies-een-lang-wachtwoord
SESSION_SECRET=nog-een-lange-willekeurige-tekst
# The https address people use, e.g. https://radio.jouwdomein.nl
PUBLIC_URL=
# Music folder on this computer (only when NOT using the NAS_ settings below).
# Synology with Docker: /volume1/music   Windows: C:/Users/Ramon/Music
MUSIC_DIR=./import
PORT=3000

# --- Only when the music is on a NAS that cannot run Docker (e.g. DS218play) ---
# IP address of the NAS in your home network (DSM → Configuratiescherm → Netwerk)
NAS_HOST=192.168.1.20
# Shared folder with the music, e.g. music  (subfolders: music/Muziek)
NAS_SHARE=music
# Separate NAS user with read-only rights on that folder
NAS_USER=onair-lezen
NAS_PASSWORD=
