# Copy to .env (same folder as docker-compose.yml) and fill in.
DB_PASSWORD=kies-een-lang-wachtwoord
SESSION_SECRET=nog-een-lange-willekeurige-tekst
# The https address people use, e.g. https://radio.jouwdomein.nl
PUBLIC_URL=
# Music folder on this computer (only when NOT using the NAS_ settings below).
# Synology with Docker: /volume1/music   Windows: C:/Users/Ramon/Music
MUSIC_DIR=./import
PORT=3000

# --- Only when the music is on a NAS that cannot run Docker (e.g. DS218play) ---
# IP address of the NAS in your home network (DSM → Configuratiescherm → Netwerk)
NAS_HOST=192.168.1.20
# Shared folder with the music, e.g. music  (subfolders: music/Muziek)
NAS_SHARE=music
# Separate NAS user with read-only rights on that folder
NAS_USER=onair-lezen
NAS_PASSWORD=

# --- Backups (daily: database + audio) ---
# Local folder, used when the NAS_BACKUP_ settings are empty:
BACKUP_DIR=./data/backup
BACKUP_KEEP_DAYS=30
# Backup to the NAS: shared folder plus a NAS user with write rights on it
NAS_BACKUP_SHARE=backup
NAS_BACKUP_USER=onair-backup
NAS_BACKUP_PASSWORD=

# --- Archief omzetten (WAV -> FLAC in a NEW folder) ---
# Local target folder, used when the NAS_ARCHIVE_ settings are empty:
ARCHIVE_DIR=./data/archief
ARCHIVE_JOBS=3
# Target on the NAS: a NEW shared folder (not the music folder itself) + user with write rights
NAS_ARCHIVE_SHARE=
NAS_ARCHIVE_USER=
NAS_ARCHIVE_PASSWORD=

# Disk space (GB) for the "zuinige modus" MP3 versions; least recently used are removed
CACHE_MAX_GB=20

# Add new music from the music folder automatically every N minutes (0 = off)
AUTO_IMPORT_MINUTES=10
