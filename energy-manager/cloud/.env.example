# Energy Manager Cloud — copy to .env and fill in. NEVER commit .env.
EMC_ENV=production
EMC_DOMAIN=cloud.example.com                 # DNS name of the server (A/AAAA record)
EMC_BASE_URL=https://cloud.example.com       # used in e-mail links
EMC_DB_PASSWORD=                             # long random value, e.g. `openssl rand -base64 32`
EMC_ENCRYPTION_KEYS=                         # `docker compose run --rm api emcloud gen-key`; comma-separated for rotation (newest first)
EMC_SECURE_COOKIES=1
EMC_SELF_REGISTRATION=1
EMC_TRIAL_DAYS=30
EMC_TRIAL_PLAN=PRO
# E-mail (required in production): an SMTP service with SPF/DKIM/DMARC set up for your domain
EMC_MAIL_MODE=smtp
EMC_SMTP_HOST=
EMC_SMTP_PORT=587
EMC_SMTP_USER=
EMC_SMTP_PASSWORD=
EMC_SMTP_FROM=Energy Manager Cloud <noreply@example.com>
EMC_SMTP_STARTTLS=1
