# Copy to .env — never commit .env.
# production = real devices only; demo = complete simulated "Demo Home"
EMS_MODE=production
EMS_PORT=8080
TZ=Europe/Amsterdam
# Secrets referenced from the configuration as ${NAME}, e.g. prices.entsoe_token: ${ENTSOE_TOKEN}
# ENTSOE_TOKEN=
# Optional PostgreSQL (docker compose --profile postgres up -d)
# POSTGRES_PASSWORD=
# EMS_DATABASE_URL=postgresql+psycopg://ems:<password>@127.0.0.1:5432/ems
